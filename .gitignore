# Local experiment verification scripts and test artifacts.
/core/tests/

# robots/<robot>/model holds the kinematics models (tracked, unlike other model/ dirs); robots/<robot>/checkpoints
# (S1 / S2 leg odometry networks) and robots/common/models (ONNX, vocabulary) are tracked; TensorRT engines are not.
!robots/*/model/*

# core/3rdparty/TRAIL (leg-odometry training): experiment outputs, caches, logs and checkpoints of runs; the released
# checkpoints live in robots/<robot>/checkpoints
/core/3rdparty/TRAIL/runs/
/core/3rdparty/TRAIL/cache/
/core/3rdparty/TRAIL/logs/
/core/3rdparty/TRAIL/**/*.pt
/core/3rdparty/TRAIL/**/*.pth
